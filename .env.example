# .env.example — Plantilla de variables de entorno
# Copia este archivo como .env y completa tus valores reales.
# NUNCA subas .env a Git — ya está en .gitignore.

# Clave de API para Alpha Vantage (https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Entorno de ejecución: dev | test | prod
ENVIRONMENT=dev
